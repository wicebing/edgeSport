{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "status", "publishDate", "showName", "episodeTitle",
    "episodeSubtitle", "summary", "language", "estimatedMinutes", "hosts",
    "sourceWeeklyReportId", "sourceRecordIds", "learningGoals", "showNotes",
    "chapters", "dialogue", "factCheck", "closingTakeaways", "disclosure", "editorReview"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string" },
    "status": { "type": "string", "enum": ["draft"] },
    "publishDate": { "type": "string" },
    "showName": { "type": "string" },
    "episodeTitle": { "type": "string" },
    "episodeSubtitle": { "type": "string" },
    "summary": { "type": "string" },
    "language": { "type": "string", "const": "en" },
    "estimatedMinutes": { "type": "integer", "minimum": 10, "maximum": 22 },
    "hosts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/host" }
    },
    "sourceWeeklyReportId": { "type": "string" },
    "sourceRecordIds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": { "type": "string" }
    },
    "learningGoals": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "type": "string" }
    },
    "showNotes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": { "type": "string" }
    },
    "chapters": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/chapter" }
    },
    "dialogue": {
      "type": "array",
      "minItems": 34,
      "maxItems": 60,
      "items": { "$ref": "#/$defs/dialogueTurn" }
    },
    "factCheck": {
      "type": "array",
      "minItems": 5,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/factCheck" }
    },
    "closingTakeaways": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "type": "string" }
    },
    "disclosure": { "type": "string" },
    "editorReview": { "$ref": "#/$defs/editorReview" }
  },
  "$defs": {
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "role"],
      "properties": {
        "id": { "type": "string", "enum": ["host", "cohost"] },
        "displayName": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "turnStart"],
      "properties": {
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "turnStart": { "type": "integer", "minimum": 1, "maximum": 60 }
      }
    },
    "dialogueTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn", "speaker", "text", "delivery", "evidenceSourceIds"],
      "properties": {
        "turn": { "type": "integer", "minimum": 1, "maximum": 60 },
        "speaker": { "type": "string", "enum": ["host", "cohost"] },
        "text": { "type": "string", "minLength": 20, "maxLength": 520 },
        "delivery": { "type": "string", "enum": ["warm", "curious", "reflective", "clear", "light", "cautious", "encouraging"] },
        "evidenceSourceIds": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "items": { "type": "string" }
        }
      }
    },
    "factCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "evidenceSourceIds", "boundary"],
      "properties": {
        "claim": { "type": "string" },
        "evidenceSourceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "string" }
        },
        "boundary": { "type": "string" }
      }
    },
    "editorReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedForPublish", "verifiedBy", "verifiedAt"],
      "properties": {
        "approvedForPublish": { "type": "boolean", "const": false },
        "verifiedBy": { "type": "string", "const": "" },
        "verifiedAt": { "type": "string", "const": "" }
      }
    }
  }
}
